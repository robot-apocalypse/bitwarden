{$DOMAIN} {
    log {
        level INFO
        output file /data/access.log {
            roll_size 10MB
            roll_keep 10
        }
    }

    # Vaultwarden reads the client IP from X-Real-IP (IP_HEADER). Without
    # this it logged every request as caddy's bridge IP, which made both its
    # rate limiting and fail2ban useless.
    reverse_proxy vaultwarden:80 {
        header_up X-Real-IP {remote_host}
    }

    header {
        # HSTS for this host only: no includeSubDomains, since other
        # peakscale.solutions hosts are not managed here.
        Strict-Transport-Security "max-age=31536000"
        -Server
        -X-Powered-By
    }
}
